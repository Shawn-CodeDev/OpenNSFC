        <mxCell id="e_c1_c2" value="提供自变量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c1" target="c2">
